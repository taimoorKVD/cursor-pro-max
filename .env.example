META_VERIFY_TOKEN=replace-with-long-random-string
META_APP_SECRET=replace-with-meta-app-secret
META_ACCESS_TOKEN=replace-with-meta-access-token
META_PHONE_NUMBER_ID=replace-with-phone-number-id
META_WABA_ID=
META_GRAPH_VERSION=v23.0
META_WEBHOOK_SYNC_ENABLED=true
ALLOWED_WHATSAPP_NUMBERS=923001234567

# Telegram (recommended while WhatsApp Cloud API billing is unavailable)
TELEGRAM_BOT_TOKEN=
TELEGRAM_POLLING_ENABLED=true
ALLOWED_TELEGRAM_USER_IDS=
REPLY_LOG_ENABLED=true

# Private web chat at /chat (min 12 chars; leave empty to disable)
WEBCHAT_PASSWORD=
WEBCHAT_SESSION_DAYS=7

# Groq for natural ChatGPT-style understanding (https://console.groq.com/keys)
# Leave GROQ_API_KEY empty to use regex-only parsing.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_CHAT_ENABLED=true
# iPhone/web mic button (device microphone → Whisper). Requires GROQ_API_KEY.
GROQ_VOICE_ENABLED=true
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Cursor Agent auth (https://cursor.com/dashboard?tab=integrations → API Keys)
# CURSOR_API_KEY = fully automatic / headless. Without it, CURSOR_AUTO_LOGIN runs
# `agent login` for CURSOR_ACCOUNT_EMAIL when the session expires.
# Required for self-improving chat on whatsapp-cursor-orchestrator (live agent runs).
CURSOR_ACCOUNT_EMAIL=info@kingdom-vision.com
CURSOR_AUTO_LOGIN=true
CURSOR_LOGIN_TIMEOUT_SEC=180
CURSOR_API_KEY=

# Email when Cloudflare quick-tunnel URL changes (scripts/notify-tunnel-url.ps1)
TUNNEL_URL_EMAIL_ENABLED=true
TUNNEL_URL_NOTIFY_TO=taimoor.kingdomvision@gmail.com
SMTP_HOST=mail-eu.smtp2go.com
SMTP_PORT=2525
SMTP_USER=info@kingdom-vision.com
SMTP_PASSWORD=
SMTP_FROM=info@kingdom-vision.com

PROJECTS_FILE=projects.json
# Default folder whose immediate children can be scanned and registered.
# Can be changed at runtime via webchat Manage panel or "set projects root …"
# (persisted in data/projects_root.json). Leave empty until set.
PROJECTS_ROOT=C:/laragon/www
PROJECTS_ROOT_FILE=data/projects_root.json
DATABASE_FILE=data/orchestrator.sqlite
WORK_ROOT=data/workspaces
AGENT_BIN=agent
AGENT_SANDBOX=disabled
AGENT_TIMEOUT_SEC=1200
# text | json | stream-json (stream-json enables evidence-based mid-run tool events)
AGENT_OUTPUT_FORMAT=stream-json
JOB_LEASE_SEC=1800
WORKSPACE_RETENTION_DAYS=14
ORCHESTRATOR_WORKER=true
# Parallel workers so multiple project chats can run agent jobs at once (1–8)
WORKER_COUNT=3
# true = workspace only (no Cursor agent / no approve). For real chat→code→apply
# loops (including self-improving this orchestrator), set DRY_RUN=false.
DRY_RUN=true
WEBHOOK_REPLY_ENABLED=true

# Windows live agent requires the AppContainer probe. true skips it (same-user risk).
# Prefer fixing the AppContainer boundary over break-glass for production hosts.
AGENT_ISOLATION_BREAK_GLASS=false
# Production deploy stays off until health checks and rollback exist.
DEPLOY_ENABLED=false
APPROVAL_TTL_SEC=86400
# Set ORCH_QUOTAS=false only for local test runs.
ORCH_QUOTAS=true
MAX_TASKS_PER_SENDER_PER_DAY=40
MAX_AGENT_STARTS_PER_DAY=40
MAX_GROQ_CALLS_PER_DAY=300
# OpenAPI /docs stays off unless explicitly enabled.
EXPOSE_API_DOCS=false
PROJECTS_STRICT=true
